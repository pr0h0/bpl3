@args user: *User, my_notes: **Note, count: int
@import [User], [Note] from "../models.bpl"
@import [Header] from "./partials/header.bpl"
@import [Navbar] from "./partials/navbar.bpl"
@import [Footer] from "./partials/footer.bpl"
@import [NoteCard] from "./partials/note_card.bpl"

{{ !Header.render("Profile") }}
{{ !Navbar.render(user) }}

<main class="container mx-auto px-4 mt-8">
    <div class="bg-indigo-600 text-white rounded-lg shadow-lg mb-8 overflow-hidden">
        <div class="p-10">
            <h1 class="text-5xl font-extrabold mb-4">Hello, {{ user.username }}!</h1>
            <p class="text-2xl font-light text-indigo-100">Welcome to your profile.</p>
        </div>
    </div>

    <h2 class="text-3xl font-bold mb-6 text-gray-800 border-b pb-2">My Notes</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        @loop (local i: int = 0; i < count; i++) {
            {{ !NoteCard.render(my_notes[i]) }}
        }
        @if (count == 0) {
            <p class="text-gray-500 italic col-span-full py-4">You haven't posted anything yet.</p>
        }
    </div>
</main>


{{ !Footer.render() }}
