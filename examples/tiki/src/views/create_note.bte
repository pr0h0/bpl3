@args user: *User
@import [User] from "../models.bpl"
@import [Header] from "./partials/header.bpl"
@import [Navbar] from "./partials/navbar.bpl"
@import [Footer] from "./partials/footer.bpl"

{{ !Header.render("Create Note") }}
{{ !Navbar.render(user) }}

<main class="container mx-auto px-4 mt-8 max-w-2xl">
    <div class="bg-white p-8 rounded-lg shadow-md border border-gray-200">
        <h1 class="text-3xl font-bold mb-6 text-gray-800">Create a New Note</h1>
        <form action="/notes/create" method="POST" class="space-y-6">
            <div>
                <label for="title" class="block text-sm font-medium text-gray-700 mb-1">Title</label>
                <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-teal-500 focus:border-teal-500" id="title" name="title" required>
            </div>
            <div>
                <label for="content" class="block text-sm font-medium text-gray-700 mb-1">Content</label>
                <textarea class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-teal-500 focus:border-teal-500" id="content" name="content" rows="6" required></textarea>
            </div>
            <button type="submit" class="bg-teal-500 hover:bg-teal-600 text-white font-bold py-2 px-6 rounded transition">Publish</button>
        </form>
    </div>
</main>


{{ !Footer.render() }}
