@args user: *User, note: *Note
@import [User], [Note] from "../models.bpl"
@import [Header] from "./partials/header.bpl"
@import [Navbar] from "./partials/navbar.bpl"
@import [Footer] from "./partials/footer.bpl"
@import int_to_string from "../utils.bpl"

{{ !Header.render("Edit Note") }}
{{ !Navbar.render(user) }}

<main class="container mx-auto px-4 mt-8 max-w-2xl">
    <div class="bg-white p-8 rounded-lg shadow-md border border-gray-200">
        <h1 class="text-3xl font-bold mb-6 text-gray-800">Edit Note</h1>
        <form action="/notes/{{ int_to_string(note.id) }}/update" method="POST" class="space-y-6">
            <div>
                <label for="title" class="block text-sm font-medium text-gray-700 mb-1">Title</label>
                <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-teal-500 focus:border-teal-500" id="title" name="title" required value="{{ note.title }}">
            </div>
            <div>
                <label for="content" class="block text-sm font-medium text-gray-700 mb-1">Content</label>
                <textarea class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-teal-500 focus:border-teal-500" id="content" name="content" rows="6" required>{{ note.content }}</textarea>
            </div>
            <div class="flex items-center space-x-4">
                <button type="submit" class="bg-teal-500 hover:bg-teal-600 text-white font-bold py-2 px-6 rounded transition">Save Changes</button>
                <a href="/" class="bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-2 px-6 rounded transition">Cancel</a>
            </div>
        </form>
        <hr class="my-8 border-gray-300"/>
        <form action="/notes/{{ int_to_string(note.id) }}/delete" method="POST" onsubmit="return confirm('Are you sure?');">
             <button type="submit" class="bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-6 rounded transition">Delete Note</button>
        </form>
    </div>
</main>


{{ !Footer.render() }}
