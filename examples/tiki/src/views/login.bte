@args error_msg: string
@import [Header] from "./partials/header.bpl"
@import [Navbar] from "./partials/navbar.bpl"
@import [Footer] from "./partials/footer.bpl"

{{ !Header.render("Login") }}
{{ !Navbar.render(nullptr) }}

<main class="container mx-auto px-4 mt-16 max-w-md">
    <div class="bg-white p-8 rounded-lg shadow-md border border-gray-200">
        <h1 class="text-2xl font-bold mb-6 text-center text-gray-800">Please sign in</h1>
        @if (error_msg != nullptr) {
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">{{ error_msg }}</div>
        }
        <form action="/login" method="POST" class="space-y-4">
            <div>
                <label for="username" class="block text-sm font-medium text-gray-700 mb-1">Username</label>
                <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-teal-500 focus:border-teal-500" id="username" name="username" placeholder="Username" required>
            </div>
            <div>
                <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Password</label>
                <input type="password" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-teal-500 focus:border-teal-500" id="password" name="password" placeholder="Password" required>
            </div>
            <button class="w-full bg-teal-500 hover:bg-teal-600 text-white font-bold py-2 px-4 rounded transition" type="submit">Login</button>
        </form>
    </div>
</main>


{{ !Footer.render() }}
