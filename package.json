{
  "name": "bpl-v3",
  "version": "0.1.1",
  "description": "A transpiler for the BPL programming language targeting LLVM IR.",
  "main": "index.ts",
  "bin": {
    "bpl": "./bpl"
  },
  "scripts": {
    "start": "bun index.ts",
    "build": "bun build --compile --outfile=bpl ./index.ts",
    "check": "bunx tsc --noEmit --lib ESNext",
    "lint": "eslint compiler/ vscode-ext/src/ index.ts",
    "lint:fix": "eslint compiler/ vscode-ext/src/ index.ts --fix",
    "test": "bun test tests/",
    "test:baseline": "bun test 2>&1 | tee test-baseline.txt",
    "format": "prettier -u --write *",
    "format-examples": "bun index.ts format -w **/**/*.bpl",
    "playground": "cd playground &&bash ./start.sh",
    "file-sizes": "wc -l compiler/**/*.ts compiler/**/**/*.ts index.ts vscode-ext/src/*.ts 2>/dev/null | sort -n | tail -20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pr0h0/bpl3.git"
  },
  "keywords": [
    "compiler",
    "transpiler",
    "llvm",
    "bpl",
    "language"
  ],
  "author": "pr0h0",
  "license": "Apache-2.0",
  "type": "commonjs",
  "private": false,
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^9.39.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "peggy": "^5.0.6"
  }
}
