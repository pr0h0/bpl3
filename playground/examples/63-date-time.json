{
  "order": 63,
  "title": "Date and Time",
  "snippet": "Working with dates, times, and timestamps",
  "description": "Date and time operations are essential for logging, scheduling, and user-facing applications. The Date and DateTime modules from the standard library provide convenient ways to work with dates, times, and timestamps. This example demonstrates using them for common date operations.",
  "code": [
    "# Date and Time operations using std/date.bpl",
    "import [Date], [DateTime] from \"std/date.bpl\";",
    "",
    "extern printf(fmt: string, ...) ret int;",
    "extern time(ptr: *long) ret long;",
    "extern free(ptr: *void);",
    "",
    "frame main() ret int {",
    "    printf(\"=== Date and Time ===\\n\\n\");",
    "    ",
    "    # Get current timestamp",
    "    local now: long = 0;",
    "    time(&now);",
    "    printf(\"Unix timestamp: %ld\\n\\n\", now);",
    "    ",
    "    # Get today's date using stdlib",
    "    local today: Date = Date.today();",
    "    printf(\"Today's date (UTC):\\n\");",
    "    printf(\"  Year:  %d\\n\", today.year);",
    "    printf(\"  Month: %d\\n\", today.month);",
    "    printf(\"  Day:   %d\\n\\n\", today.day);",
    "    ",
    "    # Check day of week",
    "    local dow: int = today.dayOfWeek();",
    "    local dayNames: string[7] = [\"Sunday\", \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\"];",
    "    printf(\"Day of week: %s\\n\", dayNames[dow]);",
    "    ",
    "    # Check if leap year",
    "    printf(\"Is %d a leap year? %s\\n\\n\", today.year, today.isLeapYear() ? \"yes\" : \"no\");",
    "    ",
    "    # Get current datetime",
    "    local dt: DateTime = DateTime.now();",
    "    printf(\"Current time (UTC):\\n\");",
    "    printf(\"  %d-%02d-%02d %02d:%02d:%02d\\n\\n\", dt.year, dt.month, dt.day, dt.hour, dt.minute, dt.second);",
    "    ",
    "    # Format date using format()",
    "    local dateStr: string = today.format();",
    "    printf(\"Formatted date: %s\\n\", dateStr);",
    "    free(cast<*void>(dateStr));",
    "    ",
    "    # Format datetime using format()  ",
    "    local dtStr: string = dt.format();",
    "    printf(\"Formatted datetime: %s\\n\\n\", dtStr);",
    "    free(cast<*void>(dtStr));",
    "    ",
    "    # Date arithmetic - add/subtract days",
    "    printf(\"--- Date Arithmetic ---\\n\");",
    "    local tomorrow: Date = today.addDays(1);",
    "    local yesterday: Date = today.addDays(-1);",
    "    ",
    "    local tomorrowStr: string = tomorrow.format();",
    "    local yesterdayStr: string = yesterday.format();",
    "    printf(\"Yesterday: %s\\n\", yesterdayStr);",
    "    printf(\"Tomorrow:  %s\\n\", tomorrowStr);",
    "    free(cast<*void>(tomorrowStr));",
    "    free(cast<*void>(yesterdayStr));",
    "    ",
    "    # Days in month",
    "    printf(\"\\nDays in current month: %d\\n\", today.daysInMonth());",
    "    ",
    "    return 0;",
    "}"
  ]
}
