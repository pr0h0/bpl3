{
  "order": 63,
  "title": "Date and Time",
  "snippet": "Working with dates, times, and timestamps",
  "description": "Date and time operations are essential for logging, scheduling, and user-facing applications. This example demonstrates getting the current time, formatting dates, and calculating time differences using standard C library functions.",
  "code": [
    "# Date and Time operations",
    "",
    "extern printf(fmt: string, ...);",
    "extern time(ptr: *long) ret long;",
    "extern localtime(timer: *long) ret *TM;",
    "extern strftime(s: *u8, max: ulong, fmt: *u8, tm: *TM) ret ulong;",
    "extern difftime(end: long, begin: long) ret float;",
    "extern malloc(size: long) ret *void;",
    "extern free(ptr: *void);",
    "",
    "# C struct tm representation",
    "struct TM {",
    "    sec: int,",
    "    min: int,",
    "    hour: int,",
    "    mday: int,",
    "    mon: int,",
    "    year: int,",
    "    wday: int,",
    "    yday: int,",
    "    isdst: int,",
    "}",
    "",
    "frame main() ret int {",
    "    printf(\"=== Date and Time ===\\n\\n\");",
    "    ",
    "    # Get current timestamp",
    "    local now: long = 0;",
    "    time(&now);",
    "    printf(\"Unix timestamp: %ld\\n\\n\", now);",
    "    ",
    "    # Convert to local time",
    "    local tm: *TM = localtime(&now);",
    "    ",
    "    printf(\"Current time components:\\n\");",
    "    printf(\"  Year:   %d\\n\", tm.year + 1900);",
    "    printf(\"  Month:  %d\\n\", tm.mon + 1);",
    "    printf(\"  Day:    %d\\n\", tm.mday);",
    "    printf(\"  Hour:   %d\\n\", tm.hour);",
    "    printf(\"  Minute: %d\\n\", tm.min);",
    "    printf(\"  Second: %d\\n\", tm.sec);",
    "    printf(\"  Weekday: %d (0=Sun)\\n\", tm.wday);",
    "    printf(\"  Day of year: %d\\n\\n\", tm.yday);",
    "    ",
    "    # Format date with strftime",
    "    local buffer: *u8 = cast<*u8>(malloc(cast<long>(100)));",
    "    ",
    "    strftime(buffer, cast<ulong>(100), cast<*u8>(\"%Y-%m-%d %H:%M:%S\"), tm);",
    "    printf(\"ISO format: %s\\n\", buffer);",
    "    ",
    "    strftime(buffer, cast<ulong>(100), cast<*u8>(\"%A, %B %d, %Y\"), tm);",
    "    printf(\"Long format: %s\\n\", buffer);",
    "    ",
    "    strftime(buffer, cast<ulong>(100), cast<*u8>(\"%I:%M %p\"), tm);",
    "    printf(\"12-hour time: %s\\n\", buffer);",
    "    ",
    "    free(cast<*void>(buffer));",
    "    ",
    "    # Demonstrate time arithmetic",
    "    printf(\"\\n--- Time Arithmetic ---\\n\");",
    "    local yesterday: long = now - cast<long>(86400);  # 24 * 60 * 60",
    "    local tomorrow: long = now + cast<long>(86400);",
    "    ",
    "    local diff: float = difftime(tomorrow, yesterday);",
    "    printf(\"Seconds between yesterday and tomorrow: %.0f\\n\", diff);",
    "    printf(\"Hours between: %.1f\\n\", diff / 3600.0);",
    "    ",
    "    return 0;",
    "}"
  ]
}
