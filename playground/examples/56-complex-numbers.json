{
  "order": 56,
  "title": "Complex Numbers",
  "snippet": "Complex number arithmetic",
  "description": "BPL supports complex number operations through the Complex struct from the standard library. Complex numbers have real and imaginary parts and support arithmetic operations like addition, subtraction, multiplication, and division. This example demonstrates basic complex number operations including magnitude, phase, and conjugate calculations.",
  "code": [
    "# Complex number arithmetic using std/complex.bpl",
    "import [Complex] from \"std/complex.bpl\";",
    "",
    "extern printf(fmt: string, ...);",
    "",
    "frame main() ret int {",
    "    printf(\"=== Complex Numbers ===\\n\\n\");",
    "    ",
    "    # Create complex numbers using the standard library",
    "    local z1: Complex = Complex.new(3.0, 4.0);  # 3 + 4i",
    "    local z2: Complex = Complex.new(1.0, 2.0);  # 1 + 2i",
    "    ",
    "    printf(\"z1 = %.1f + %.1fi\\n\", z1.real, z1.imag);",
    "    printf(\"z2 = %.1f + %.1fi\\n\\n\", z2.real, z2.imag);",
    "    ",
    "    # Addition",
    "    local sum: Complex = z1.add(z2);",
    "    printf(\"z1 + z2 = %.1f + %.1fi\\n\", sum.real, sum.imag);",
    "    ",
    "    # Subtraction",
    "    local diff: Complex = z1.sub(z2);",
    "    printf(\"z1 - z2 = %.1f + %.1fi\\n\", diff.real, diff.imag);",
    "    ",
    "    # Multiplication",
    "    local prod: Complex = z1.mul(z2);",
    "    printf(\"z1 * z2 = %.1f + %.1fi\\n\", prod.real, prod.imag);",
    "    ",
    "    # Division",
    "    local quot: Complex = z1.div(z2);",
    "    printf(\"z1 / z2 = %.2f + %.2fi\\n\", quot.real, quot.imag);",
    "    ",
    "    # Conjugate",
    "    local conj: Complex = z1.conjugate();",
    "    printf(\"conj(z1) = %.1f + %.1fi\\n\", conj.real, conj.imag);",
    "    ",
    "    # Magnitude |z1|",
    "    local mag: float = z1.abs();",
    "    printf(\"|z1| = %.2f\\n\", mag);",
    "    ",
    "    # |z1|^2",
    "    local magSq: float = z1.absSquared();",
    "    printf(\"|z1|^2 = %.1f\\n\", magSq);",
    "    ",
    "    return 0;",
    "}"
  ]
}
