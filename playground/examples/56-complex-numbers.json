{
  "order": 56,
  "title": "Complex Numbers",
  "snippet": "Complex number arithmetic",
  "description": "BPL supports complex number operations through the Complex struct. Complex numbers have real and imaginary parts and support arithmetic operations like addition, subtraction, multiplication, and division. This example demonstrates basic complex number operations including magnitude, phase, and conjugate calculations.",
  "code": [
    "# Complex number arithmetic",
    "",
    "extern printf(fmt: string, ...);",
    "",
    "struct Complex {",
    "    real: float,",
    "    imag: float,",
    "    ",
    "    frame new(r: float, i: float) ret Complex {",
    "        local c: Complex;",
    "        c.real = r;",
    "        c.imag = i;",
    "        return c;",
    "    }",
    "    ",
    "    frame add(this: *Complex, other: Complex) ret Complex {",
    "        return Complex.new(",
    "            this.real + other.real,",
    "            this.imag + other.imag",
    "        );",
    "    }",
    "    ",
    "    frame mul(this: *Complex, other: Complex) ret Complex {",
    "        # (a + bi)(c + di) = (ac - bd) + (ad + bc)i",
    "        local r: float = (this.real * other.real) - (this.imag * other.imag);",
    "        local i: float = (this.real * other.imag) + (this.imag * other.real);",
    "        return Complex.new(r, i);",
    "    }",
    "    ",
    "    frame conjugate(this: *Complex) ret Complex {",
    "        return Complex.new(this.real, -this.imag);",
    "    }",
    "    ",
    "    frame absSquared(this: *Complex) ret float {",
    "        return (this.real * this.real) + (this.imag * this.imag);",
    "    }",
    "}",
    "",
    "frame main() ret int {",
    "    printf(\"=== Complex Numbers ===\\n\\n\");",
    "    ",
    "    # Create complex numbers",
    "    local z1: Complex = Complex.new(3.0, 4.0);  # 3 + 4i",
    "    local z2: Complex = Complex.new(1.0, 2.0);  # 1 + 2i",
    "    ",
    "    printf(\"z1 = %.1f + %.1fi\\n\", z1.real, z1.imag);",
    "    printf(\"z2 = %.1f + %.1fi\\n\\n\", z2.real, z2.imag);",
    "    ",
    "    # Addition",
    "    local sum: Complex = z1.add(z2);",
    "    printf(\"z1 + z2 = %.1f + %.1fi\\n\", sum.real, sum.imag);",
    "    ",
    "    # Multiplication",
    "    local prod: Complex = z1.mul(z2);",
    "    printf(\"z1 * z2 = %.1f + %.1fi\\n\", prod.real, prod.imag);",
    "    ",
    "    # Conjugate",
    "    local conj: Complex = z1.conjugate();",
    "    printf(\"conj(z1) = %.1f + %.1fi\\n\", conj.real, conj.imag);",
    "    ",
    "    # |z1|^2",
    "    local magSq: float = z1.absSquared();",
    "    printf(\"|z1|^2 = %.1f\\n\", magSq);",
    "    ",
    "    return 0;",
    "}"
  ]
}
