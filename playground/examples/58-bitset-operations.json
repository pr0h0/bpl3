{
  "order": 58,
  "title": "BitSet Operations",
  "snippet": "Efficient bit array for flags and sets",
  "description": "A BitSet is a compact data structure for storing a set of bits (boolean flags). It's more memory-efficient than an array of booleans and supports fast bitwise operations. Common uses include tracking visited nodes in graph algorithms, implementing Bloom filters, or storing feature flags. This example shows basic BitSet operations.",
  "code": [
    "# BitSet - efficient bit array operations",
    "",
    "extern printf(fmt: string, ...);",
    "extern malloc(size: long) ret *void;",
    "extern free(ptr: *void);",
    "extern memset(dest: *void, c: int, n: long) ret *void;",
    "",
    "struct BitSet {",
    "    data: *u64,",
    "    numBits: int,",
    "    numWords: int,",
    "    ",
    "    frame new(bits: int) ret BitSet {",
    "        local bs: BitSet;",
    "        bs.numBits = bits;",
    "        bs.numWords = (bits + 63) / 64;",
    "        bs.data = cast<*u64>(malloc(cast<long>(bs.numWords * 8)));",
    "        memset(cast<*void>(bs.data), 0, cast<long>(bs.numWords * 8));",
    "        return bs;",
    "    }",
    "    ",
    "    frame set(this: *BitSet, idx: int) {",
    "        if ((idx < 0) || (idx >= this.numBits)) { return; }",
    "        local word: int = idx / 64;",
    "        local bit: int = idx % 64;",
    "        local ptr: *u64 = this.data + word;",
    "        *ptr = *ptr | (cast<u64>(1) << cast<u64>(bit));",
    "    }",
    "    ",
    "    frame clear(this: *BitSet, idx: int) {",
    "        if ((idx < 0) || (idx >= this.numBits)) { return; }",
    "        local word: int = idx / 64;",
    "        local bit: int = idx % 64;",
    "        local ptr: *u64 = this.data + word;",
    "        *ptr = *ptr & ~(cast<u64>(1) << cast<u64>(bit));",
    "    }",
    "    ",
    "    frame test(this: *BitSet, idx: int) ret bool {",
    "        if ((idx < 0) || (idx >= this.numBits)) { return false; }",
    "        local word: int = idx / 64;",
    "        local bit: int = idx % 64;",
    "        local ptr: *u64 = this.data + word;",
    "        return (*ptr & (cast<u64>(1) << cast<u64>(bit))) != cast<u64>(0);",
    "    }",
    "    ",
    "    frame destroy(this: *BitSet) {",
    "        if (this.data != nullptr) {",
    "            free(cast<*void>(this.data));",
    "        }",
    "    }",
    "}",
    "",
    "frame main() ret int {",
    "    printf(\"=== BitSet Example ===\\n\\n\");",
    "    ",
    "    # Create a BitSet with 100 bits",
    "    local bs: BitSet = BitSet.new(100);",
    "    ",
    "    # Set some bits (prime numbers under 30)",
    "    bs.set(2);",
    "    bs.set(3);",
    "    bs.set(5);",
    "    bs.set(7);",
    "    bs.set(11);",
    "    bs.set(13);",
    "    bs.set(17);",
    "    bs.set(19);",
    "    bs.set(23);",
    "    bs.set(29);",
    "    ",
    "    # Test which bits are set",
    "    printf(\"Primes under 30: \");",
    "    local i: int = 0;",
    "    loop (i < 30) {",
    "        if (bs.test(i)) {",
    "            printf(\"%d \", i);",
    "        }",
    "        i = i + 1;",
    "    }",
    "    printf(\"\\n\\n\");",
    "    ",
    "    # Clear a bit",
    "    bs.clear(5);",
    "    printf(\"After clearing 5: \");",
    "    i = 0;",
    "    loop (i < 30) {",
    "        if (bs.test(i)) {",
    "            printf(\"%d \", i);",
    "        }",
    "        i = i + 1;",
    "    }",
    "    printf(\"\\n\");",
    "    ",
    "    bs.destroy();",
    "    return 0;",
    "}"
  ]
}
