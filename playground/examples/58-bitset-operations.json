{
  "order": 58,
  "title": "BitSet Operations",
  "snippet": "Efficient bit array for flags and sets",
  "description": "A BitSet is a compact data structure for storing a set of bits (boolean flags). It's more memory-efficient than an array of booleans and supports fast bitwise operations. Common uses include tracking visited nodes in graph algorithms, implementing Bloom filters, or storing feature flags. The BitSet module from the standard library provides all common operations. This example shows how to use it.",
  "code": [
    "# BitSet operations using std/bitset.bpl",
    "import [BitSet] from \"std/bitset.bpl\";",
    "",
    "extern printf(fmt: string, ...) ret int;",
    "",
    "frame main() ret int {",
    "    printf(\"=== BitSet Example ===\\n\\n\");",
    "    ",
    "    # Create a BitSet with 100 bits",
    "    local bs: BitSet = BitSet.new(100);",
    "    ",
    "    # Set some bits (prime numbers under 30)",
    "    bs.set(2);",
    "    bs.set(3);",
    "    bs.set(5);",
    "    bs.set(7);",
    "    bs.set(11);",
    "    bs.set(13);",
    "    bs.set(17);",
    "    bs.set(19);",
    "    bs.set(23);",
    "    bs.set(29);",
    "    ",
    "    # Test which bits are set",
    "    printf(\"Primes under 30: \");",
    "    local i: int = 0;",
    "    loop (i < 30) {",
    "        if (bs.test(i)) {",
    "            printf(\"%d \", i);",
    "        }",
    "        i = i + 1;",
    "    }",
    "    printf(\"\\n\\n\");",
    "    ",
    "    # Flip a bit (toggle)",
    "    bs.flip(5);",
    "    printf(\"After flipping 5 (was set, now clear): \");",
    "    i = 0;",
    "    loop (i < 30) {",
    "        if (bs.test(i)) {",
    "            printf(\"%d \", i);",
    "        }",
    "        i = i + 1;",
    "    }",
    "    printf(\"\\n\\n\");",
    "    ",
    "    # Count set bits using stdlib method",
    "    local count: int = bs.count();",
    "    printf(\"Number of primes under 30 (excluding 5): %d\\n\", count);",
    "    ",
    "    # Check if any/all bits are set",
    "    printf(\"Any bit set: %s\\n\", bs.any() ? \"yes\" : \"no\");",
    "    ",
    "    # Clear all bits",
    "    bs.clearAll();",
    "    printf(\"After clearAll - Any bit set: %s\\n\", bs.any() ? \"yes\" : \"no\");",
    "    ",
    "    bs.destroy();",
    "    return 0;",
    "}"
  ]
}
