{
  "order": 57,
  "title": "Rational Numbers",
  "snippet": "Fraction arithmetic with automatic simplification",
  "description": "The Rational struct from the standard library represents fractions (rational numbers) with automatic simplification. It stores a numerator and denominator as long integers and provides exact arithmetic without floating-point errors. Operations like add, subtract, multiply, and divide work with fractions directly. This is useful for financial calculations or any domain requiring exact fractional values.",
  "code": [
    "# Rational number (fraction) arithmetic using std/rational.bpl",
    "import [Rational] from \"std/rational.bpl\";",
    "",
    "import [printf] from \"std/c.bpl\";",
    "",
    "frame main() ret int {",
    "    printf(\"=== Rational Numbers ===\\n\\n\");",
    "    ",
    "    # Create fractions using the standard library",
    "    local r1: Rational = Rational.new(cast<long>(3), cast<long>(4));  # 3/4",
    "    local r2: Rational = Rational.new(cast<long>(2), cast<long>(5));  # 2/5",
    "    ",
    "    printf(\"r1 = %ld/%ld\\n\", r1.num, r1.den);",
    "    printf(\"r2 = %ld/%ld\\n\\n\", r2.num, r2.den);",
    "    ",
    "    # Addition: 3/4 + 2/5 = 15/20 + 8/20 = 23/20",
    "    local sum: Rational = r1.add(r2);",
    "    printf(\"r1 + r2 = %ld/%ld\\n\", sum.num, sum.den);",
    "    ",
    "    # Subtraction",
    "    local diff: Rational = r1.sub(r2);",
    "    printf(\"r1 - r2 = %ld/%ld\\n\", diff.num, diff.den);",
    "    ",
    "    # Multiplication: 3/4 * 2/5 = 6/20 = 3/10",
    "    local prod: Rational = r1.mul(r2);",
    "    printf(\"r1 * r2 = %ld/%ld\\n\", prod.num, prod.den);",
    "    ",
    "    # Division",
    "    local quot: Rational = r1.div(r2);",
    "    printf(\"r1 / r2 = %ld/%ld\\n\", quot.num, quot.den);",
    "    ",
    "    # Auto-simplification",
    "    local r3: Rational = Rational.new(cast<long>(6), cast<long>(8));",
    "    printf(\"\\n6/8 simplified = %ld/%ld\\n\", r3.num, r3.den);",
    "    ",
    "    # Convert to float",
    "    printf(\"3/4 as float = %.4f\\n\", r1.toFloat());",
    "    ",
    "    # Comparison (greaterThan takes a pointer)",
    "    if (r1.greaterThan(&r2)) {",
    "        printf(\"3/4 > 2/5\\n\");",
    "    }",
    "    ",
    "    return 0;",
    "}"
  ]
}
