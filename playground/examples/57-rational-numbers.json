{
  "order": 57,
  "title": "Rational Numbers",
  "snippet": "Fraction arithmetic with automatic simplification",
  "description": "The Rational struct represents fractions (rational numbers) with automatic simplification. It stores a numerator and denominator as long integers and provides exact arithmetic without floating-point errors. Operations like add, subtract, multiply, and divide work with fractions directly. This is useful for financial calculations or any domain requiring exact fractional values.",
  "code": [
    "# Rational number (fraction) arithmetic",
    "",
    "extern printf(fmt: string, ...);",
    "",
    "struct Rational {",
    "    num: long,  # numerator",
    "    den: long,  # denominator",
    "    ",
    "    frame gcd(a: long, b: long) ret long {",
    "        if (a < cast<long>(0)) { a = -a; }",
    "        if (b < cast<long>(0)) { b = -b; }",
    "        loop (b != cast<long>(0)) {",
    "            local temp: long = b;",
    "            b = a % b;",
    "            a = temp;",
    "        }",
    "        return a;",
    "    }",
    "    ",
    "    frame new(n: long, d: long) ret Rational {",
    "        local r: Rational;",
    "        if (d < cast<long>(0)) {",
    "            n = -n;",
    "            d = -d;",
    "        }",
    "        local g: long = Rational.gcd(n, d);",
    "        r.num = n / g;",
    "        r.den = d / g;",
    "        return r;",
    "    }",
    "    ",
    "    frame add(this: *Rational, other: Rational) ret Rational {",
    "        local n: long = (this.num * other.den) + (other.num * this.den);",
    "        local d: long = this.den * other.den;",
    "        return Rational.new(n, d);",
    "    }",
    "    ",
    "    frame mul(this: *Rational, other: Rational) ret Rational {",
    "        return Rational.new(this.num * other.num, this.den * other.den);",
    "    }",
    "    ",
    "    frame toFloat(this: *Rational) ret float {",
    "        return cast<float>(this.num) / cast<float>(this.den);",
    "    }",
    "}",
    "",
    "frame main() ret int {",
    "    printf(\"=== Rational Numbers ===\\n\\n\");",
    "    ",
    "    # Create fractions",
    "    local r1: Rational = Rational.new(cast<long>(3), cast<long>(4));  # 3/4",
    "    local r2: Rational = Rational.new(cast<long>(2), cast<long>(5));  # 2/5",
    "    ",
    "    printf(\"r1 = %ld/%ld\\n\", r1.num, r1.den);",
    "    printf(\"r2 = %ld/%ld\\n\\n\", r2.num, r2.den);",
    "    ",
    "    # Addition: 3/4 + 2/5 = 15/20 + 8/20 = 23/20",
    "    local sum: Rational = r1.add(r2);",
    "    printf(\"r1 + r2 = %ld/%ld\\n\", sum.num, sum.den);",
    "    ",
    "    # Multiplication: 3/4 * 2/5 = 6/20 = 3/10",
    "    local prod: Rational = r1.mul(r2);",
    "    printf(\"r1 * r2 = %ld/%ld\\n\", prod.num, prod.den);",
    "    ",
    "    # Auto-simplification",
    "    local r3: Rational = Rational.new(cast<long>(6), cast<long>(8));",
    "    printf(\"6/8 simplified = %ld/%ld\\n\", r3.num, r3.den);",
    "    ",
    "    # Convert to float",
    "    printf(\"3/4 as float = %.4f\\n\", r1.toFloat());",
    "    ",
    "    return 0;",
    "}"
  ]
}
