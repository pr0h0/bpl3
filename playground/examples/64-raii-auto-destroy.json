{
  "order": 64,
  "title": "RAII Auto Destroy",
  "snippet": "Scope-based cleanup with @[auto_destroy]",
  "description": "BPL destructors are opt-in. A destroy(this: *T) method runs automatically for value locals only when it is marked with @[auto_destroy]. This example shows nested scopes, deterministic cleanup, and the difference between inner-scope and function-scope teardown.",
  "code": [
    "import [printf] from \"std/c.bpl\";",
    "",
    "global destroyed: int = 0;",
    "",
    "struct Resource {",
    "    id: int,",
    "",
    "    @[auto_destroy]",
    "    frame destroy(this: *Resource) ret void {",
    "        destroyed = destroyed + this.id;",
    "        printf(\"destroy %d\\n\", this.id);",
    "    }",
    "}",
    "",
    "frame scoped() ret void {",
    "    local outer: Resource;",
    "    outer.id = 3;",
    "",
    "    {",
    "        local inner: Resource;",
    "        inner.id = 4;",
    "    }",
    "",
    "    printf(\"after inner scope: %d\\n\", destroyed);",
    "}",
    "",
    "frame main() ret int {",
    "    scoped();",
    "    printf(\"after function scope: %d\\n\", destroyed);",
    "    return 0;",
    "}"
  ]
}
