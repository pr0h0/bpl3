{
  "order": 65,
  "title": "Runtime Type Guards",
  "snippet": "Use is and as for safe downcasts",
  "description": "Struct pointers in inheritance hierarchies can be checked at runtime. The is operator narrows simple identifiers inside the true branch, while as returns a nullable pointer for safe downcasts that you want to store.",
  "code": [
    "import [printf] from \"std/c.bpl\";",
    "",
    "struct Animal {",
    "    name: string,",
    "",
    "    frame kind(this: *Animal) ret string {",
    "        return \"animal\";",
    "    }",
    "}",
    "",
    "struct Dog : Animal {",
    "    breed: string,",
    "}",
    "",
    "struct Cat : Animal {",
    "    indoor: bool,",
    "}",
    "",
    "frame describe(animal: *Animal) ret void {",
    "    if (animal is Dog) {",
    "        printf(\"Dog %s is a %s\\n\", animal.name, animal.breed);",
    "        return;",
    "    }",
    "",
    "    local cat: *Cat = animal as *Cat;",
    "    if (cat != nullptr) {",
    "        printf(\"Cat %s indoor=%d\\n\", cat.name, cat.indoor ? 1 : 0);",
    "        return;",
    "    }",
    "",
    "    printf(\"Unknown animal: %s\\n\", animal.name);",
    "}",
    "",
    "frame main() ret int {",
    "    local dog: Dog;",
    "    dog.name = \"Mika\";",
    "    dog.breed = \"Lab\";",
    "",
    "    local cat: Cat;",
    "    cat.name = \"Nori\";",
    "    cat.indoor = true;",
    "",
    "    describe(cast<*Animal>(&dog));",
    "    describe(cast<*Animal>(&cat));",
    "    return 0;",
    "}"
  ]
}
