{
  "order": 62,
  "title": "Environment Variables",
  "snippet": "Read and work with system environment variables",
  "description": "Environment variables are key-value pairs that configure program behavior at runtime. They're commonly used for configuration, API keys, paths, and system settings. The Env module from the standard library provides convenient functions to get, set, and work with environment variables.",
  "code": [
    "# Reading environment variables using std/env.bpl",
    "import [Env] from \"std/env.bpl\";",
    "",
    "extern printf(fmt: string, ...);",
    "",
    "frame main() ret int {",
    "    printf(\"=== Environment Variables ===\\n\\n\");",
    "    ",
    "    # Get common environment variables using Env module",
    "    printf(\"Common environment variables:\\n\");",
    "    ",
    "    local home: string = Env.getOr(\"HOME\", \"(not set)\");",
    "    printf(\"  HOME: %s\\n\", home);",
    "    ",
    "    local user: string = Env.getOr(\"USER\", \"(not set)\");",
    "    printf(\"  USER: %s\\n\", user);",
    "    ",
    "    local shell: string = Env.getOr(\"SHELL\", \"(not set)\");",
    "    printf(\"  SHELL: %s\\n\", shell);",
    "    ",
    "    local pwd: string = Env.getOr(\"PWD\", \"(not set)\");",
    "    printf(\"  PWD: %s\\n\", pwd);",
    "    ",
    "    local lang: string = Env.getOr(\"LANG\", \"(not set)\");",
    "    printf(\"  LANG: %s\\n\", lang);",
    "    ",
    "    # Check for PATH (exists but truncate for display)",
    "    local path: string = Env.get(\"PATH\");",
    "    if (path != nullptr) {",
    "        printf(\"  PATH: (set, truncated)\\n\");",
    "    } else {",
    "        printf(\"  PATH: (not set)\\n\");",
    "    }",
    "    ",
    "    printf(\"\\n--- Custom Variable Check ---\\n\");",
    "    ",
    "    # Check for a custom variable with default",
    "    local config: string = Env.getOr(\"MY_APP_CONFIG\", \"default_config\");",
    "    printf(\"MY_APP_CONFIG = %s\\n\", config);",
    "    ",
    "    # Check if a variable exists",
    "    if (Env.get(\"MY_APP_CONFIG\") == nullptr) {",
    "        printf(\"(Using default - set with: export MY_APP_CONFIG=value)\\n\");",
    "    }",
    "    ",
    "    return 0;",
    "}"
  ]
}
