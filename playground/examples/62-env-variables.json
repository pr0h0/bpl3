{
  "order": 62,
  "title": "Environment Variables",
  "snippet": "Read and work with system environment variables",
  "description": "Environment variables are key-value pairs that configure program behavior at runtime. They're commonly used for configuration, API keys, paths, and system settings. This example shows how to read environment variables using the standard C library's getenv function.",
  "code": [
    "# Reading environment variables",
    "",
    "extern printf(fmt: string, ...);",
    "extern getenv(name: *u8) ret *u8;",
    "",
    "frame main() ret int {",
    "    printf(\"=== Environment Variables ===\\n\\n\");",
    "    ",
    "    # Common environment variables to check",
    "    local vars: *u8[6];",
    "    vars[0] = cast<*u8>(\"HOME\");",
    "    vars[1] = cast<*u8>(\"USER\");",
    "    vars[2] = cast<*u8>(\"PATH\");",
    "    vars[3] = cast<*u8>(\"SHELL\");",
    "    vars[4] = cast<*u8>(\"PWD\");",
    "    vars[5] = cast<*u8>(\"LANG\");",
    "    ",
    "    local i: int = 0;",
    "    loop (i < 6) {",
    "        local name: *u8 = vars[i];",
    "        local value: *u8 = getenv(name);",
    "        ",
    "        if (value != nullptr) {",
    "            # Truncate PATH for display",
    "            if (i == 2) {",
    "                printf(\"%s: (truncated)\\n\", name);",
    "            } else {",
    "                printf(\"%s: %s\\n\", name, value);",
    "            }",
    "        } else {",
    "            printf(\"%s: (not set)\\n\", name);",
    "        }",
    "        i = i + 1;",
    "    }",
    "    ",
    "    printf(\"\\n--- Custom Variable Check ---\\n\");",
    "    ",
    "    local custom: *u8 = getenv(cast<*u8>(\"MY_APP_CONFIG\"));",
    "    if (custom != nullptr) {",
    "        printf(\"MY_APP_CONFIG = %s\\n\", custom);",
    "    } else {",
    "        printf(\"MY_APP_CONFIG is not set\\n\");",
    "        printf(\"Set it with: export MY_APP_CONFIG=value\\n\");",
    "    }",
    "    ",
    "    return 0;",
    "}"
  ]
}
