{
  "order": 60,
  "title": "Hex Encoding",
  "snippet": "Convert bytes to hexadecimal strings",
  "description": "Hexadecimal (hex) encoding represents each byte as two hexadecimal characters (0-9, a-f). It's commonly used for debugging, displaying binary data, and representing colors in web development. The Hex module from the standard library provides encode and decode functions. This example shows how to use them.",
  "code": [
    "# Hex encoding using std/hex.bpl",
    "import [Hex] from \"std/hex.bpl\";",
    "",
    "import [printf] from \"std/c.bpl\";",
    "import [strlen] from \"std/c.bpl\";",
    "import [free] from \"std/c.bpl\";",
    "",
    "frame main() ret int {",
    "    printf(\"=== Hex Encoding ===\\n\\n\");",
    "    ",
    "    # Encode string to hex using standard library",
    "    local input: string = \"Hello\";",
    "    local encoded: string = Hex.encode(cast<*u8>(input), strlen(input));",
    "    printf(\"'%s' in hex: %s\\n\", input, encoded);",
    "    ",
    "    # Uppercase hex",
    "    local encodedUpper: string = Hex.encodeUpper(cast<*u8>(input), strlen(input));",
    "    printf(\"'%s' in HEX: %s\\n\", input, encodedUpper);",
    "    ",
    "    # Show individual bytes",
    "    printf(\"\\nByte-by-byte:\\n\");",
    "    local ptr: *u8 = cast<*u8>(input);",
    "    local i: int = 0;",
    "    loop (i < strlen(input)) {",
    "        local b: u8 = *(ptr + i);",
    "        printf(\"  '%c' = 0x%02x (%d)\\n\", b, b, b);",
    "        i = i + 1;",
    "    }",
    "    ",
    "    # Some example bytes",
    "    printf(\"\\nOther examples:\\n\");",
    "    local bytes: u8[4] = [cast<u8>(0), cast<u8>(127), cast<u8>(128), cast<u8>(255)];",
    "    local hexBytes: string = Hex.encode(&bytes[0], 4);",
    "    printf(\"[0, 127, 128, 255] -> %s\\n\", hexBytes);",
    "    ",
    "    # Decode hex back to string using decodeToString",
    "    local decoded: string = Hex.decodeToString(encoded);",
    "    printf(\"\\nDecoded: '%s'\\n\", decoded);",
    "    ",
    "    free(cast<*void>(encoded));",
    "    free(cast<*void>(encodedUpper));",
    "    free(cast<*void>(hexBytes));",
    "    free(cast<*void>(decoded));",
    "    ",
    "    return 0;",
    "}"
  ]
}
