{
  "order": 60,
  "title": "Hex Encoding",
  "snippet": "Convert bytes to hexadecimal strings",
  "description": "Hexadecimal (hex) encoding represents each byte as two hexadecimal characters (0-9, a-f). It's commonly used for debugging, displaying binary data, and representing colors in web development. This example shows how to encode bytes to hex strings and decode hex back to bytes.",
  "code": [
    "# Hex encoding and decoding",
    "",
    "extern printf(fmt: string, ...);",
    "extern malloc(size: long) ret *void;",
    "extern free(ptr: *void);",
    "extern strlen(s: string) ret int;",
    "",
    "# Encode bytes to hex string",
    "frame hex_encode(data: *u8, length: int) ret string {",
    "    local hexChars: string = \"0123456789abcdef\";",
    "    local hexPtr: *u8 = cast<*u8>(hexChars);",
    "    ",
    "    local outLen: int = length * 2;",
    "    local output: *u8 = cast<*u8>(malloc(cast<long>(outLen + 1)));",
    "    ",
    "    local i: int = 0;",
    "    loop (i < length) {",
    "        local b: u8 = *(data + i);",
    "        local hi: int = cast<int>(b >> cast<u8>(4));",
    "        local lo: int = cast<int>(b & cast<u8>(15));",
    "        *(output + (i * 2)) = *(hexPtr + hi);",
    "        *(output + (i * 2) + 1) = *(hexPtr + lo);",
    "        i = i + 1;",
    "    }",
    "    ",
    "    *(output + outLen) = cast<u8>(0);",
    "    return cast<string>(output);",
    "}",
    "",
    "# Convert hex char to value",
    "frame hex_char_value(c: u8) ret int {",
    "    if ((c >= cast<u8>(48)) && (c <= cast<u8>(57))) {",
    "        return cast<int>(c) - 48;  # 0-9",
    "    }",
    "    if ((c >= cast<u8>(97)) && (c <= cast<u8>(102))) {",
    "        return cast<int>(c) - 97 + 10;  # a-f",
    "    }",
    "    if ((c >= cast<u8>(65)) && (c <= cast<u8>(70))) {",
    "        return cast<int>(c) - 65 + 10;  # A-F",
    "    }",
    "    return -1;",
    "}",
    "",
    "frame main() ret int {",
    "    printf(\"=== Hex Encoding ===\\n\\n\");",
    "    ",
    "    # Encode string to hex",
    "    local input: string = \"Hello\";",
    "    local encoded: string = hex_encode(cast<*u8>(input), strlen(input));",
    "    printf(\"'%s' in hex: %s\\n\", input, encoded);",
    "    ",
    "    # Show individual bytes",
    "    printf(\"\\nByte-by-byte:\\n\");",
    "    local ptr: *u8 = cast<*u8>(input);",
    "    local i: int = 0;",
    "    loop (i < strlen(input)) {",
    "        local b: u8 = *(ptr + i);",
    "        printf(\"  '%c' = 0x%02x (%d)\\n\", b, b, b);",
    "        i = i + 1;",
    "    }",
    "    ",
    "    # Some example bytes",
    "    printf(\"\\nOther examples:\\n\");",
    "    local bytes: u8[4] = [cast<u8>(0), cast<u8>(127), cast<u8>(128), cast<u8>(255)];",
    "    local hexBytes: string = hex_encode(&bytes[0], 4);",
    "    printf(\"[0, 127, 128, 255] -> %s\\n\", hexBytes);",
    "    ",
    "    free(cast<*void>(encoded));",
    "    free(cast<*void>(hexBytes));",
    "    ",
    "    return 0;",
    "}"
  ]
}
