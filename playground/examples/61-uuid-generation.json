{
  "order": 61,
  "title": "UUID Generation",
  "snippet": "Generate universally unique identifiers",
  "description": "UUIDs (Universally Unique Identifiers) are 128-bit identifiers used to uniquely identify information. Version 4 UUIDs are randomly generated and have a format like 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'. They're commonly used for database primary keys, session IDs, and distributed systems. This example demonstrates UUID generation and formatting.",
  "code": [
    "# UUID v4 generation (random)",
    "",
    "extern printf(fmt: string, ...);",
    "extern malloc(size: long) ret *void;",
    "extern free(ptr: *void);",
    "extern time(ptr: *long) ret long;",
    "",
    "# Simple LCG random number generator",
    "global RAND_STATE: ulong = 12345;",
    "",
    "frame rand_seed() {",
    "    local t: long = 0;",
    "    time(&t);",
    "    RAND_STATE = cast<ulong>(t);",
    "}",
    "",
    "frame rand_next() ret int {",
    "    RAND_STATE = (RAND_STATE * 1664525) + 1013904223;",
    "    return cast<int>(RAND_STATE & 0xFFFFFFFF);",
    "}",
    "",
    "struct UUID {",
    "    bytes: u8[16],",
    "    ",
    "    frame v4() ret UUID {",
    "        local uuid: UUID;",
    "        local i: int = 0;",
    "        ",
    "        # Fill with random bytes",
    "        loop (i < 16) {",
    "            uuid.bytes[i] = cast<u8>(rand_next() & 255);",
    "            i = i + 1;",
    "        }",
    "        ",
    "        # Set version to 4 (bits 12-15 of time_hi_and_version)",
    "        uuid.bytes[6] = (uuid.bytes[6] & cast<u8>(0x0F)) | cast<u8>(0x40);",
    "        ",
    "        # Set variant to RFC 4122 (10xx xxxx)",
    "        uuid.bytes[8] = (uuid.bytes[8] & cast<u8>(0x3F)) | cast<u8>(0x80);",
    "        ",
    "        return uuid;",
    "    }",
    "    ",
    "    frame toString(this: *UUID) ret string {",
    "        local output: *u8 = cast<*u8>(malloc(cast<long>(37)));",
    "        local hexChars: string = \"0123456789abcdef\";",
    "        local hexPtr: *u8 = cast<*u8>(hexChars);",
    "        ",
    "        local outIdx: int = 0;",
    "        local i: int = 0;",
    "        ",
    "        loop (i < 16) {",
    "            local b: u8 = this.bytes[i];",
    "            local hi: int = cast<int>(b >> cast<u8>(4));",
    "            local lo: int = cast<int>(b & cast<u8>(15));",
    "            ",
    "            *(output + outIdx) = *(hexPtr + hi);",
    "            outIdx = outIdx + 1;",
    "            *(output + outIdx) = *(hexPtr + lo);",
    "            outIdx = outIdx + 1;",
    "            ",
    "            # Add dashes at positions 4, 6, 8, 10",
    "            if ((i == 3) || (i == 5) || (i == 7) || (i == 9)) {",
    "                *(output + outIdx) = cast<u8>(45);  # '-'",
    "                outIdx = outIdx + 1;",
    "            }",
    "            i = i + 1;",
    "        }",
    "        ",
    "        *(output + 36) = cast<u8>(0);",
    "        return cast<string>(output);",
    "    }",
    "}",
    "",
    "frame main() ret int {",
    "    printf(\"=== UUID Generation ===\\n\\n\");",
    "    ",
    "    rand_seed();",
    "    ",
    "    # Generate some UUIDs",
    "    printf(\"Generated UUIDs (v4 random):\\n\");",
    "    local i: int = 0;",
    "    loop (i < 5) {",
    "        local uuid: UUID = UUID.v4();",
    "        local str: string = uuid.toString();",
    "        printf(\"  %s\\n\", str);",
    "        free(cast<*void>(str));",
    "        i = i + 1;",
    "    }",
    "    ",
    "    return 0;",
    "}"
  ]
}
