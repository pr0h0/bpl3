{
  "order": 55,
  "title": "Stats Library",
  "snippet": "Statistical functions for data analysis",
  "description": "The Stats module provides statistical functions for numerical analysis including mean, sum, min, max, range, variance, standard deviation, and median. All functions are overloaded to work with both integer and float arrays. This example demonstrates basic statistical operations on numerical data using the standard library.",
  "code": [
    "# Statistical functions using std/stats.bpl",
    "import [Stats] from \"std/stats.bpl\";",
    "",
    "import [printf] from \"std/c.bpl\";",
    "",
    "frame main() ret int {",
    "    # Sample data",
    "    local data: int[5] = [10, 20, 30, 40, 50];",
    "    local length: int = 5;",
    "    ",
    "    printf(\"=== Statistics Example ===\\n\");",
    "    printf(\"Data: 10, 20, 30, 40, 50\\n\\n\");",
    "    ",
    "    # Calculate statistics using Stats module",
    "    local avg: float = Stats.mean(&data[0], length);",
    "    local minVal: int = Stats.min(&data[0], length);",
    "    local maxVal: int = Stats.max(&data[0], length);",
    "    local range: int = Stats.range(&data[0], length);",
    "    local sum: long = Stats.sum(&data[0], length);",
    "    ",
    "    printf(\"Mean: %.2f\\n\", avg);",
    "    printf(\"Min: %d\\n\", minVal);",
    "    printf(\"Max: %d\\n\", maxVal);",
    "    printf(\"Range: %d\\n\", range);",
    "    printf(\"Sum: %ld\\n\", sum);",
    "    ",
    "    return 0;",
    "}"
  ]
}
