{
  "order": 55,
  "title": "Stats Library",
  "snippet": "Statistical functions for data analysis",
  "description": "The Stats module provides statistical functions for numerical analysis including mean, sum, min, max, range, variance, standard deviation, and median. All functions are overloaded to work with both integer and float arrays. This example demonstrates basic statistical operations on numerical data.",
  "code": [
    "# Statistical functions example",
    "# Note: In playground, we simulate stats functions",
    "",
    "extern printf(fmt: string, ...);",
    "extern malloc(size: long) ret *void;",
    "extern free(ptr: *void);",
    "",
    "# Simulate Stats.mean for int array",
    "frame mean(data: *int, length: int) ret float {",
    "    local sum: int = 0;",
    "    local i: int = 0;",
    "    loop (i < length) {",
    "        sum = sum + *(data + i);",
    "        i = i + 1;",
    "    }",
    "    return cast<float>(sum) / cast<float>(length);",
    "}",
    "",
    "# Simulate Stats.min",
    "frame min(data: *int, length: int) ret int {",
    "    local minVal: int = *data;",
    "    local i: int = 1;",
    "    loop (i < length) {",
    "        if (*(data + i) < minVal) {",
    "            minVal = *(data + i);",
    "        }",
    "        i = i + 1;",
    "    }",
    "    return minVal;",
    "}",
    "",
    "# Simulate Stats.max",
    "frame max(data: *int, length: int) ret int {",
    "    local maxVal: int = *data;",
    "    local i: int = 1;",
    "    loop (i < length) {",
    "        if (*(data + i) > maxVal) {",
    "            maxVal = *(data + i);",
    "        }",
    "        i = i + 1;",
    "    }",
    "    return maxVal;",
    "}",
    "",
    "frame main() ret int {",
    "    # Sample data",
    "    local data: int[5] = [10, 20, 30, 40, 50];",
    "    local length: int = 5;",
    "    ",
    "    printf(\"=== Statistics Example ===\\n\");",
    "    printf(\"Data: 10, 20, 30, 40, 50\\n\\n\");",
    "    ",
    "    # Calculate statistics",
    "    local avg: float = mean(&data[0], length);",
    "    local minVal: int = min(&data[0], length);",
    "    local maxVal: int = max(&data[0], length);",
    "    local range: int = maxVal - minVal;",
    "    ",
    "    printf(\"Mean: %.2f\\n\", avg);",
    "    printf(\"Min: %d\\n\", minVal);",
    "    printf(\"Max: %d\\n\", maxVal);",
    "    printf(\"Range: %d\\n\", range);",
    "    ",
    "    return 0;",
    "}"
  ]
}
