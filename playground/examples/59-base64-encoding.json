{
  "order": 59,
  "title": "Base64 Encoding",
  "snippet": "Encode and decode data in Base64",
  "description": "Base64 is a binary-to-text encoding scheme that represents binary data as ASCII characters. It's commonly used for encoding data in URLs, emails, and APIs. The Base64 module from the standard library provides encode and decode functions for converting between raw bytes and Base64 strings. This example shows basic Base64 encoding operations.",
  "code": [
    "# Base64 encoding using std/base64.bpl",
    "import [Base64] from \"std/base64.bpl\";",
    "",
    "extern printf(fmt: string, ...) ret int;",
    "extern strlen(s: string) ret int;",
    "extern free(ptr: *void);",
    "",
    "frame main() ret int {",
    "    printf(\"=== Base64 Encoding ===\\n\\n\");",
    "    ",
    "    # Encode some strings using the standard library",
    "    local input1: string = \"Hello\";",
    "    local encoded1: string = Base64.encode(cast<*u8>(input1), strlen(input1));",
    "    printf(\"'%s' -> '%s'\\n\", input1, encoded1);",
    "    ",
    "    local input2: string = \"BPL!\";",
    "    local encoded2: string = Base64.encode(cast<*u8>(input2), strlen(input2));",
    "    printf(\"'%s' -> '%s'\\n\", input2, encoded2);",
    "    ",
    "    local input3: string = \"Hello, World!\";",
    "    local encoded3: string = Base64.encode(cast<*u8>(input3), strlen(input3));",
    "    printf(\"'%s' -> '%s'\\n\", input3, encoded3);",
    "    ",
    "    # Decode back using decodeToString",
    "    local decoded: string = Base64.decodeToString(encoded3);",
    "    printf(\"\\nDecoded: '%s'\\n\", decoded);",
    "    ",
    "    # Free allocated strings",
    "    free(cast<*void>(encoded1));",
    "    free(cast<*void>(encoded2));",
    "    free(cast<*void>(encoded3));",
    "    free(cast<*void>(decoded));",
    "    ",
    "    return 0;",
    "}"
  ]
}
