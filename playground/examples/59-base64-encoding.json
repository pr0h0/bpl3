{
  "order": 59,
  "title": "Base64 Encoding",
  "snippet": "Encode and decode data in Base64",
  "description": "Base64 is a binary-to-text encoding scheme that represents binary data as ASCII characters. It's commonly used for encoding data in URLs, emails, and APIs. The Base64 module provides encode and decode functions for converting between raw bytes and Base64 strings. This example shows basic Base64 encoding operations.",
  "code": [
    "# Base64 encoding example",
    "",
    "extern printf(fmt: string, ...);",
    "extern malloc(size: long) ret *void;",
    "extern free(ptr: *void);",
    "extern strlen(s: string) ret int;",
    "",
    "# Simple Base64 encoder (subset for demonstration)",
    "frame base64_encode(data: *u8, length: int) ret string {",
    "    local alphabet: string = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";",
    "    local alphaPtr: *u8 = cast<*u8>(alphabet);",
    "    ",
    "    local outLen: int = ((length + 2) / 3) * 4;",
    "    local output: *u8 = cast<*u8>(malloc(cast<long>(outLen + 1)));",
    "    ",
    "    local i: int = 0;",
    "    local j: int = 0;",
    "    ",
    "    loop (i < length) {",
    "        local b0: u8 = *(data + i);",
    "        local b1: u8 = cast<u8>(0);",
    "        local b2: u8 = cast<u8>(0);",
    "        ",
    "        if ((i + 1) < length) { b1 = *(data + i + 1); }",
    "        if ((i + 2) < length) { b2 = *(data + i + 2); }",
    "        ",
    "        local idx0: int = cast<int>(b0 >> cast<u8>(2));",
    "        local idx1: int = cast<int>(((b0 & cast<u8>(3)) << cast<u8>(4)) | (b1 >> cast<u8>(4)));",
    "        local idx2: int = cast<int>(((b1 & cast<u8>(15)) << cast<u8>(2)) | (b2 >> cast<u8>(6)));",
    "        local idx3: int = cast<int>(b2 & cast<u8>(63));",
    "        ",
    "        *(output + j) = *(alphaPtr + idx0);",
    "        *(output + j + 1) = *(alphaPtr + idx1);",
    "        *(output + j + 2) = ((i + 1) < length) ? *(alphaPtr + idx2) : cast<u8>(61);",
    "        *(output + j + 3) = ((i + 2) < length) ? *(alphaPtr + idx3) : cast<u8>(61);",
    "        ",
    "        i = i + 3;",
    "        j = j + 4;",
    "    }",
    "    ",
    "    *(output + outLen) = cast<u8>(0);",
    "    return cast<string>(output);",
    "}",
    "",
    "frame main() ret int {",
    "    printf(\"=== Base64 Encoding ===\\n\\n\");",
    "    ",
    "    # Encode some strings",
    "    local input1: string = \"Hello\";",
    "    local encoded1: string = base64_encode(cast<*u8>(input1), strlen(input1));",
    "    printf(\"'%s' -> '%s'\\n\", input1, encoded1);",
    "    ",
    "    local input2: string = \"BPL!\";",
    "    local encoded2: string = base64_encode(cast<*u8>(input2), strlen(input2));",
    "    printf(\"'%s' -> '%s'\\n\", input2, encoded2);",
    "    ",
    "    local input3: string = \"A\";",
    "    local encoded3: string = base64_encode(cast<*u8>(input3), strlen(input3));",
    "    printf(\"'%s' -> '%s'\\n\", input3, encoded3);",
    "    ",
    "    local input4: string = \"AB\";",
    "    local encoded4: string = base64_encode(cast<*u8>(input4), strlen(input4));",
    "    printf(\"'%s' -> '%s'\\n\", input4, encoded4);",
    "    ",
    "    # Free allocated strings",
    "    free(cast<*void>(encoded1));",
    "    free(cast<*void>(encoded2));",
    "    free(cast<*void>(encoded3));",
    "    free(cast<*void>(encoded4));",
    "    ",
    "    return 0;",
    "}"
  ]
}
