# dependencies (bun install)
node_modules

# output
out
dist
*.tgz
# The bundled packages' archives are committed on purpose: the Docker image,
# the release smoke and the package tests install them by path. Rebuild one
# with `bpl pack` in its package directory after changing its sources.
!packages/*/*.tgz

# code coverage
coverage
*.lcov

# logs
logs
_.log
report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# caches
.eslintcache
.cache
*.tsbuildinfo

# IntelliJ based IDEs
.idea

# Finder (MacOS) folder config
.DS_Store

# example build artifacts
examples/**
!examples/**/
!examples/**/*.bpl
!examples/**/*.bte
!examples/**/test_config.json
!examples/**/bpl.json
!examples/*.json
!examples/college_web/README.md
!examples/college_web/.gitignore
!examples/college_web/public/**

temp/**
!temp/*.bpl

lib/*.asm
lib/*.o
lib/*.ll

.bpl-cache
.worktrees/
bpl

ir.ll
tests/ir.ll
*.dump
/tmp

**/views/**/*.bpl
!examples/web_server_demo/views/home.bpl

# benchmark output artifacts
benchmark/results.json
benchmark/latest-results.json

