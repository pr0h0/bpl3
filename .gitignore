lib/.runtime-build.*/
lib/*.o
lib/*.a
lib/*.so
lib/*.bc

# Agent and editor files
.claude
.vscode/

# Local test output and temporary test workspaces
test-baseline.txt
.web-*-*/
tests/temp_*

