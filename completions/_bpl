#compdef bpl
# Zsh completion script for bpl CLI.
# Generated by scripts/generate_completions.ts from the CLI's command
# definitions; do not edit by hand.
# Installation:
#   1. Copy this file to a directory in your $fpath (e.g., /usr/local/share/zsh/site-functions/_bpl)
#   2. Or run: bpl completion zsh > ~/.local/share/zsh/completions/_bpl
#      and add that directory to fpath in ~/.zshrc
#   3. Reload completions: rm -f ~/.zcompdump; compinit

_bpl() {
    local curcontext="$curcontext" state line
    typeset -A opt_args

    local -a commands
    commands=(
        'run:Compile and execute a BPL program'
        'run-script:Run a script defined in bpl.json'
        'rs:Run a script defined in bpl.json'
        'dev:Development mode\: watch, compile, and run automatically'
        'build:Compile a BPL program'
        'check:Type check BPL files without generating code (fast)'
        'format:Format BPL files, directories, or stdin (-)'
        'lint:Lint BPL files, directories, or stdin (-)'
        'pack:Create a distributable package from a BPL project'
        'install:Install a BPL package'
        'lock:Re-resolve bpl.json dependencies and rewrite bpl.lock'
        'list:List installed packages'
        'init:Initialize a new BPL project'
        'uninstall:Uninstall a package'
        'remove:Uninstall a package'
        'package-cache:List, verify, repair, and clean cached package archives'
        'completion:Generate shell completion script (bash or zsh)'
        'docs:Generate Markdown documentation for a BPL file and its imports'
        'new:Create a new BPL project with standard structure'
        'clean:Remove build artifacts and caches'
        'bindgen:Generate BPL extern declarations from a C header'
        'doctor:Check local BPL toolchain and runtime setup'
        'help:display help for command'
    )

    _arguments -C \
        '(-e --eval)'{-e,--eval}'[evaluate BPL code passed as string]:value' \
        '--stdin[read BPL code from stdin]' \
        '(-o --output)'{-o,--output}'[output file path]:value:_files' \
        '--emit[emit type: llvm, ast, tokens, formatted]:value:(llvm ast tokens formatted)' \
        '(-d --dwarf)'{-d,--dwarf}'[generate DWARF debug information]' \
        '--target[target triple for clang (e.g. x86_64-pc-windows-gnu)]:value:(x86_64-pc-linux-gnu aarch64-unknown-linux-gnu arm64-apple-darwin x86_64-apple-darwin x86_64-pc-windows-gnu wasm32-unknown-unknown wasm32-wasi)' \
        '--sysroot[sysroot path for cross-compilation]:value:_directories' \
        '--cpu[target CPU for clang (e.g. znver4)]:value' \
        '--march[target architecture for clang (e.g. arm64)]:value' \
        '--clang-flag[additional flags forwarded directly to clang]:value' \
        '--wasm-runtime[wasm runtime mode: freestanding or host]:value:(freestanding host)' \
        '--debug-ir-path[write diagnostic LLVM IR to a file]:value:_files' \
        '(-l --lib)'{-l,--lib}'[libraries to link with]:value' \
        '(-L --lib-path)'{-L,--lib-path}'[library search paths]:value:_directories' \
        '--object[object files to link (.o, .ll, etc.)]:value:_files -g "*.{o,ll,bc}"' \
        '(-v --verbose)'{-v,--verbose}'[enable verbose output]' \
        '(-q --quiet)'{-q,--quiet}'[suppress non-error output]' \
        '--cache[enable incremental compilation with module caching]' \
        '--cache-stats[show incremental cache hit/miss statistics]' \
        '(-j --jobs)'{-j,--jobs}'[parallel module compilation jobs for cached builds]:value' \
        '--no-prelude[do not load implicit primitives]' \
        '-O[optimization level: 0, 1, 2, or 3]:value' \
        '--debug[generate debug information (DWARF, alias for --dwarf)]' \
        '--time[show compilation time statistics]' \
        '--json[output in JSON format]' \
        '--color[force colored output]' \
        '--no-color[disable colored output]' \
        '(-V --version)'{-V,--version}'[output the version number]' \
        '(-h --help)'{-h,--help}'[display help for command]' \
        '1: :->command' \
        '*:: :->args'

    case $state in
        command)
            _describe -t commands 'bpl command' commands
            _files -g "*.{bpl,x}"
            ;;
        args)
            case $line[1] in
                run)
                    _arguments \
                        '--project[use main/entry from ./bpl.json (implied when no file is given)]' \
                        '(-o --output)'{-o,--output}'[keep the executable at this path (default: temporary, removed on exit)]:value:_files' \
                        '(-v --verbose)'{-v,--verbose}'[enable verbose output]' \
                        '(-q --quiet)'{-q,--quiet}'[suppress non-error output]' \
                        '-O[optimization level: 0, 1, 2, or 3]:value' \
                        '--debug[generate debug information (DWARF)]' \
                        '--debug-ir-path[write diagnostic LLVM IR to a file]:value:_files' \
                        '--time[show compilation time statistics]' \
                        '--cache[enable incremental compilation with module caching]' \
                        '(-j --jobs)'{-j,--jobs}'[parallel module compilation jobs for cached builds]:value' \
                        '(-l --lib)'{-l,--lib}'[libraries to link with]:value' \
                        '(-L --lib-path)'{-L,--lib-path}'[library search paths]:value:_directories' \
                        '--object[object files to link (.o, .ll, etc.)]:value:_files -g "*.{o,ll,bc}"' \
                        '--clang-flag[additional flags forwarded directly to clang]:value' \
                        '--no-prelude[do not load implicit primitives]' \
                        '--color[force colored output]' \
                        '--no-color[disable colored output]' \
                        '(-h --help)'{-h,--help}'[display help for command]' \
                        '*:argument:_files'
                    ;;
                run-script|rs)
                    _arguments \
                        '--list[list scripts without executing one]' \
                        '--json[output machine-readable script list]' \
                        '(-h --help)'{-h,--help}'[display help for command]'
                    ;;
                dev)
                    _arguments \
                        '(-v --verbose)'{-v,--verbose}'[enable verbose output]' \
                        '(-q --quiet)'{-q,--quiet}'[suppress non-error output]' \
                        '--clear[clear screen on each recompile]' \
                        '--no-run[compile only, don'\''t execute]' \
                        '-O[optimization level: 0, 1, 2, or 3]:value' \
                        '--debug[generate debug information (DWARF)]' \
                        '--debug-ir-path[write diagnostic LLVM IR to a file]:value:_files' \
                        '--time[show compilation time statistics]' \
                        '--cache[enable incremental compilation with module caching]' \
                        '--cache-stats[show incremental cache hit/miss statistics]' \
                        '--no-prelude[do not load implicit primitives]' \
                        '--color[force colored output]' \
                        '--no-color[disable colored output]' \
                        '(-h --help)'{-h,--help}'[display help for command]' \
                        '*:argument:_files'
                    ;;
                build)
                    _arguments \
                        '(-o --output)'{-o,--output}'[output file path]:value:_files' \
                        '--shared[build a native shared library (requires -o, no main required)]' \
                        '--header[write a C header for c_export functions (requires --shared)]:value:_files' \
                        '--emit[emit type: llvm, ast, tokens, formatted]:value:(llvm ast tokens formatted)' \
                        '--project[use main/entry from ./bpl.json (implied when no file is given)]' \
                        '(-v --verbose)'{-v,--verbose}'[enable verbose output]' \
                        '(-q --quiet)'{-q,--quiet}'[suppress non-error output]' \
                        '-O[optimization level: 0, 1, 2, or 3]:value' \
                        '--debug[generate debug information (DWARF)]' \
                        '--time[show compilation time statistics]' \
                        '--target[target triple for clang (e.g. x86_64-pc-windows-gnu)]:value:(x86_64-pc-linux-gnu aarch64-unknown-linux-gnu arm64-apple-darwin x86_64-apple-darwin x86_64-pc-windows-gnu wasm32-unknown-unknown wasm32-wasi)' \
                        '--sysroot[sysroot path for cross-compilation]:value:_directories' \
                        '--cpu[target CPU for clang (e.g. znver4)]:value' \
                        '--march[target architecture for clang (e.g. arm64)]:value' \
                        '--clang-flag[additional flags forwarded directly to clang]:value' \
                        '--wasm-runtime[wasm runtime mode: freestanding or host]:value:(freestanding host)' \
                        '--debug-ir-path[write diagnostic LLVM IR to a file]:value:_files' \
                        '(-l --lib)'{-l,--lib}'[libraries to link with]:value' \
                        '(-L --lib-path)'{-L,--lib-path}'[library search paths]:value:_directories' \
                        '--object[object files to link (.o, .ll, etc.)]:value:_files -g "*.{o,ll,bc}"' \
                        '--cache[enable incremental compilation with module caching]' \
                        '--cache-stats[show incremental cache hit/miss statistics]' \
                        '(-j --jobs)'{-j,--jobs}'[parallel module compilation jobs for cached builds]:value' \
                        '--no-prelude[do not load implicit primitives]' \
                        '--color[force colored output]' \
                        '--no-color[disable colored output]' \
                        '--json[output in JSON format]' \
                        '(-h --help)'{-h,--help}'[display help for command]' \
                        '*:argument:_files'
                    ;;
                check)
                    _arguments \
                        '(-v --verbose)'{-v,--verbose}'[enable verbose output]' \
                        '(-q --quiet)'{-q,--quiet}'[suppress non-error output]' \
                        '--json[output results in JSON format]' \
                        '--time[show type checking time statistics]' \
                        '--no-prelude[do not load implicit primitives]' \
                        '--color[force colored output]' \
                        '--no-color[disable colored output]' \
                        '(-h --help)'{-h,--help}'[display help for command]' \
                        '*:argument:_files -g "*.{bpl,x}"'
                    ;;
                format)
                    _arguments \
                        '--stdin-filepath[source path for stdin diagnostics and configuration]:value:_files' \
                        '(-w --write)'{-w,--write}'[write formatted output back to file]' \
                        '--check[check whether files are formatted without writing]' \
                        '--config[use an explicit formatter JSON configuration]:value:_files' \
                        '--no-config[use BPL defaults without project configuration]' \
                        '--indent-width[override indentation width (1 to 16)]:value' \
                        '--use-tabs[indent with tabs]' \
                        '--no-use-tabs[indent with spaces]' \
                        '--line-ending[override layout line endings: lf or crlf]:value:(lf crlf)' \
                        '(-v --verbose)'{-v,--verbose}'[enable verbose output]' \
                        '--json[output machine-readable format check result]' \
                        '(-h --help)'{-h,--help}'[display help for command]' \
                        '*:argument:_files -g "*.{bpl,x}"'
                    ;;
                lint)
                    _arguments \
                        '--stdin-filepath[source path for stdin diagnostics and configuration]:value:_files' \
                        '(-v --verbose)'{-v,--verbose}'[enable verbose output]' \
                        '--no-fail-on-warnings[report warnings without failing (errors still fail)]' \
                        '--json[output lint diagnostics in JSON format]' \
                        '(-h --help)'{-h,--help}'[display help for command]' \
                        '*:argument:_files -g "*.{bpl,x}"'
                    ;;
                pack)
                    _arguments \
                        '(-o --output)'{-o,--output}'[output directory for the package]:value:_files' \
                        '--json[output machine-readable pack result]' \
                        '(-h --help)'{-h,--help}'[display help for command]'
                    ;;
                install)
                    _arguments \
                        '(-g --global)'{-g,--global}'[install package globally]' \
                        '(-v --verbose)'{-v,--verbose}'[verbose output]' \
                        '--locked[verify bpl.lock without changing installed packages]' \
                        '--update[re-resolve bpl.json dependencies and rewrite bpl.lock]' \
                        '--repair-lock[rewrite bpl.lock from currently installed packages]' \
                        '--json[output machine-readable install result]' \
                        '(-h --help)'{-h,--help}'[display help for command]' \
                        '*:argument:_files'
                    ;;
                lock)
                    _arguments \
                        '(-v --verbose)'{-v,--verbose}'[verbose output]' \
                        '--json[output machine-readable lock result]' \
                        '(-h --help)'{-h,--help}'[display help for command]'
                    ;;
                list)
                    _arguments \
                        '(-g --global)'{-g,--global}'[list global packages]' \
                        '--tree[show dependency tree]' \
                        '--json[output machine-readable installed package data]' \
                        '(-h --help)'{-h,--help}'[display help for command]'
                    ;;
                init)
                    _arguments \
                        '--json[output machine-readable init result]' \
                        '(-h --help)'{-h,--help}'[display help for command]'
                    ;;
                uninstall|remove)
                    _arguments \
                        '(-g --global)'{-g,--global}'[uninstall global package]' \
                        '--json[output machine-readable uninstall result]' \
                        '(-h --help)'{-h,--help}'[display help for command]'
                    ;;
                package-cache)
                    local -a subcommands
                    subcommands=(
                        'list:List cached package archives'
                        'verify:Verify cached package archive provenance'
                        'clean:Remove cached package archives'
                        'repair:Regenerate missing or invalid package cache provenance'
                    )
                    _arguments -C \
                        '1: :->subcommand' \
                        '*:: :->subargs'
                    case $state in
                        subcommand)
                            _describe -t subcommands 'package-cache subcommand' subcommands
                            ;;
                        subargs)
                            case $line[1] in
                            list)
                                _arguments \
                                    '--json[output machine-readable cache entries]' \
                                    '(-h --help)'{-h,--help}'[display help for command]'
                                ;;
                            verify)
                                _arguments \
                                    '--json[output machine-readable verification report]' \
                                    '(-h --help)'{-h,--help}'[display help for command]'
                                ;;
                            clean)
                                _arguments \
                                    '--package-version[only remove a specific package version]:value' \
                                    '--dry-run[show what would be removed without deleting files]' \
                                    '--json[output machine-readable clean result]' \
                                    '(-h --help)'{-h,--help}'[display help for command]'
                                ;;
                            repair)
                                _arguments \
                                    '--package-version[only repair a specific package version]:value' \
                                    '--dry-run[show what would be repaired without writing files]' \
                                    '--json[output machine-readable repair result]' \
                                    '(-h --help)'{-h,--help}'[display help for command]'
                                ;;
                            esac
                            ;;
                    esac
                    ;;
                completion)
                    _arguments \
                        '--json[output a machine-readable completion report]' \
                        '(-h --help)'{-h,--help}'[display help for command]' \
                        '1:argument:(bash zsh)'
                    ;;
                docs)
                    _arguments \
                        '(-o --output)'{-o,--output}'[Output file path (default: docs.md)]:value:_files' \
                        '--force[replace an existing output file]' \
                        '--public-only[document exported declarations only]' \
                        '--json[output a machine-readable documentation report]' \
                        '(-h --help)'{-h,--help}'[display help for command]' \
                        '*:argument:_files'
                    ;;
                new)
                    _arguments \
                        '--template[project template: app or library]:value:(app library)' \
                        '(-v --verbose)'{-v,--verbose}'[enable verbose output]' \
                        '--no-git[do not initialize git repository]' \
                        '--json[output machine-readable project creation result]' \
                        '(-h --help)'{-h,--help}'[display help for command]'
                    ;;
                clean)
                    _arguments \
                        '(-v --verbose)'{-v,--verbose}'[enable verbose output]' \
                        '--dry-run[show what would be deleted without actually deleting]' \
                        '--json[output machine-readable cleanup report]' \
                        '(-h --help)'{-h,--help}'[display help for command]'
                    ;;
                bindgen)
                    _arguments \
                        '(-o --output)'{-o,--output}'[write generated bindings to a file]:value:_files' \
                        '--json[output a machine-readable bindgen report]' \
                        '(-h --help)'{-h,--help}'[display help for command]' \
                        '*:argument:_files'
                    ;;
                doctor)
                    _arguments \
                        '--json[output machine-readable diagnostics]' \
                        '(-h --help)'{-h,--help}'[display help for command]' \
                        '1:argument:(packages sanitizer)'
                    ;;
                help)
                    _arguments \
                        '1:command:(run run-script rs dev build check format lint pack install lock list init uninstall remove package-cache completion docs new clean bindgen doctor help)'
                    ;;
            esac
            ;;
    esac
}

_bpl "$@"
