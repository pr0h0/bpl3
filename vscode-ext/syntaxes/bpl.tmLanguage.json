{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "BPL",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.bpl",
          "begin": "/#",
          "end": "#/"
        },
        {
          "name": "comment.line.number-sign.bpl",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.bpl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "meta.embedded.line.bpl",
              "contentName": "source.bpl",
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.bpl"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.bpl"
                }
              },
              "patterns": [
                {
                  "include": "#numbers"
                },
                {
                  "include": "#operators"
                },
                {
                  "include": "#constants"
                },
                {
                  "match": "[a-zA-Z_][a-zA-Z0-9_]*",
                  "name": "variable.other.bpl"
                }
              ]
            },
            {
              "name": "constant.character.escape.bpl",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.bpl",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.bpl",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.bpl",
          "match": "\\b(if|else|loop|break|continue|return|switch|case|default|try|catch|catchOther|throw|defer|fallthrough)\\b"
        },
        {
          "name": "keyword.control.import.bpl",
          "match": "\\b(import|from|as|export|extern)\\b"
        },
        {
          "name": "storage.type.function.bpl",
          "match": "\\b(frame)\\b"
        },
        {
          "name": "storage.type.class.bpl",
          "match": "\\b(struct|spec|enum)\\b"
        },
        {
          "name": "storage.type.bpl",
          "match": "\\b(type)\\b"
        },
        {
          "name": "storage.modifier.bpl",
          "match": "\\b(global|local|const|ret|static)\\b"
        },
        {
          "name": "keyword.operator.bpl",
          "match": "\\b(cast|sizeof|is|as)\\b"
        },
        {
          "name": "keyword.control.bpl",
          "match": "\\b(match|asm)\\b"
        },
        {
          "name": "variable.language.bpl",
          "match": "\\b(this|self|Self)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.bpl",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.bpl",
          "match": "\\b(null|nullptr)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.bpl",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.bpl",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.octal.bpl",
          "match": "\\b0o[0-7]+\\b"
        },
        {
          "name": "constant.numeric.float.bpl",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.bpl",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.bpl",
          "match": "(=|\\+=|\\-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=)"
        },
        {
          "name": "keyword.operator.comparison.bpl",
          "match": "(==|!=|<|>|<=|>=)"
        },
        {
          "name": "keyword.operator.logical.bpl",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.arithmetic.bpl",
          "match": "(\\+|\\-|\\*|/|%|\\+\\+|\\-\\-)"
        },
        {
          "name": "keyword.operator.bitwise.bpl",
          "match": "(&|\\||\\^|~|<<|>>)"
        },
        {
          "name": "keyword.operator.other.bpl",
          "match": "(\\?|::|->|=>)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.accessor.bpl",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.comma.bpl",
          "match": ","
        },
        {
          "name": "punctuation.terminator.statement.bpl",
          "match": ";"
        },
        {
          "name": "punctuation.separator.colon.bpl",
          "match": ":"
        },
        {
          "name": "meta.brace.round.bpl",
          "match": "[\\(\\)]"
        },
        {
          "name": "meta.brace.square.bpl",
          "match": "[\\[\\]]"
        },
        {
          "name": "meta.brace.curly.bpl",
          "match": "[\\{\\}]"
        },
        {
          "name": "punctuation.definition.template-expression.begin.bpl",
          "match": "<"
        },
        {
          "name": "punctuation.definition.template-expression.end.bpl",
          "match": ">"
        }
      ]
    }
  },
  "scopeName": "source.bpl"
}
