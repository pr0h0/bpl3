{
  "name": "bpl3-vscode",
  "displayName": "BPL3 Language Support",
  "description": "Language support for BPL3",
  "version": "0.0.1",
  "publisher": "pr0h0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pr0h0/bpl3.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/vscode-ext/src/extension.js",
  "activationEvents": [
    "onLanguage:bpl"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -b && node scripts/copy-assets.js",
    "compile:test": "tsc --project tsconfig.test.json",
    "watch": "tsc -b -w",
    "package": "vsce package",
    "test": "npm run compile && npm run compile:test && bun test ./src/test"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "peggy": "^5.0.6",
    "vscode-languageclient": "^8.1.0",
    "vscode-languageserver": "^8.1.0",
    "vscode-languageserver-textdocument": "^1.0.8"
  },
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": ".bplfmt.json",
        "url": "./out/schemas/bpl-format.schema.json"
      },
      {
        "fileMatch": "bpl.json",
        "url": "./out/schemas/bpl-package.schema.json"
      }
    ],
    "configurationDefaults": {
      "[bpl]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      }
    },
    "languages": [
      {
        "id": "bpl",
        "aliases": [
          "BPL3",
          "bpl"
        ],
        "extensions": [
          ".bpl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bpl",
        "scopeName": "source.bpl",
        "path": "./syntaxes/bpl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "bpl",
        "path": "./snippets/bpl.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "BPL3 configuration",
      "properties": {
        "bplLanguageServer.maxNumberOfProblems": {
          "scope": "resource",
          "type": "number",
          "default": 100,
          "description": "Controls the maximum number of problems produced by the server."
        },
        "bplLanguageServer.formatOnSave": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "Format BPL on save when editor.formatOnSave is not explicitly configured. Native editor settings take precedence."
        },
        "bplLanguageServer.bplHome": {
          "scope": "resource",
          "type": "string",
          "description": "Path to BPL installation directory (BPL_HOME)."
        }
      }
    }
  }
}
